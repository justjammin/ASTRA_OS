{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comparative-deliberation.schema.json",
  "title": "MAGI Comparative Deliberation",
  "type": "object",
  "required": ["tribunal_id", "core_name", "assessments", "preferred_plan_id", "rationale"],
  "additionalProperties": false,
  "properties": {
    "tribunal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "core_name": { "enum": ["Melchior-1", "Balthasar-2", "Casper-3"] },
    "assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["candidate_plan_id", "strengths", "risks"],
        "additionalProperties": false,
        "properties": {
          "candidate_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
          "strengths": { "type": "string", "minLength": 1 },
          "risks": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preferred_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
    "rationale": { "type": "string", "minLength": 1 }
  }
}

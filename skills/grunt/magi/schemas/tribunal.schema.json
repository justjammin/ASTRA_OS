{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tribunal.schema.json",
  "title": "Resolved MAGI Tribunal",
  "type": "object",
  "required": ["schema_version", "tribunal_id", "tie_break", "candidate_plans", "comparative_deliberations", "sealed_pairwise_ballots", "result"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tribunal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "tie_break": { "$ref": "tribunal-submission.schema.json#/properties/tie_break" },
    "candidate_plans": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "candidate-plan.schema.json" } },
    "comparative_deliberations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "comparative-deliberation.schema.json" } },
    "sealed_pairwise_ballots": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "pairwise-ballot.schema.json" } },
    "result": {
      "type": "object",
      "required": ["method", "matchup_results", "selected_plan_id", "support", "rationale", "dissent"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["condorcet", "aggregate-margin-cycle-break", "seeded-cycle-break"] },
        "matchup_results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["matchup_id", "candidate_plan_ids", "vote_totals", "winner_plan_id", "loser_plan_id", "margin"],
            "additionalProperties": false,
            "properties": {
              "matchup_id": { "enum": ["melchior-v-balthasar", "melchior-v-casper", "balthasar-v-casper"] },
              "candidate_plan_ids": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] } },
              "vote_totals": {
                "type": "object",
                "required": ["melchior-plan", "balthasar-plan", "casper-plan"],
                "additionalProperties": false,
                "properties": {
                  "melchior-plan": { "type": "integer", "minimum": 0, "maximum": 3 },
                  "balthasar-plan": { "type": "integer", "minimum": 0, "maximum": 3 },
                  "casper-plan": { "type": "integer", "minimum": 0, "maximum": 3 }
                }
              },
              "winner_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
              "loser_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
              "margin": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          }
        },
        "selected_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
        "support": {
          "type": "object",
          "required": ["matchup_wins", "ballots_for", "ballots_against", "aggregate_margin"],
          "additionalProperties": false,
          "properties": {
            "matchup_wins": { "type": "integer", "minimum": 1, "maximum": 2 },
            "ballots_for": { "type": "integer", "minimum": 0, "maximum": 6 },
            "ballots_against": { "type": "integer", "minimum": 0, "maximum": 6 },
            "aggregate_margin": { "type": "integer", "minimum": -6, "maximum": 6 }
          }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "dissent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["core_name", "preferred_plan_id", "rationale"],
            "additionalProperties": false,
            "properties": {
              "core_name": { "enum": ["Melchior-1", "Balthasar-2", "Casper-3"] },
              "preferred_plan_id": { "enum": ["melchior-plan", "balthasar-plan", "casper-plan"] },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

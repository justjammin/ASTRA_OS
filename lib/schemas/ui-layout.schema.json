{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "astra-os/ui-layout.schema.json",
  "title": "Astra Gate 1 — UI Layout",
  "description": "Structured visual intent emitted with 01-product.md. The visualizer renders each screen as a plain HTML sandbox mockup so a non-technical human can validate intent before any architecture exists.",
  "type": "object",
  "required": ["meta", "screens"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "intent"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "intent": { "type": "string", "minLength": 1 },
        "generatedBy": { "type": "string" },
        "headless": { "type": "boolean", "description": "true when the product has no UI surface; screens may then be empty" }
      },
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "elements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^u[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "label"],
              "properties": {
                "type": {
                  "enum": [
                    "heading",
                    "text",
                    "button",
                    "input",
                    "select",
                    "checkbox",
                    "table",
                    "list",
                    "card",
                    "image",
                    "nav",
                    "form",
                    "chart",
                    "badge",
                    "modal",
                    "terminal"
                  ]
                },
                "label": { "type": "string" },
                "notes": { "type": "string" },
                "children": { "type": "array", "items": { "type": "object" } }
              },
              "additionalProperties": false
            }
          },
          "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" }
        }
      }
    }
  }
}

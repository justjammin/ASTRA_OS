{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "astra-os/audit.schema.json",
  "title": "Astra Gate 2 — Adversarial Audit",
  "description": "Output of the judge pass: a solo skeptic (grunt) or the three-persona MAGI tribunal. Findings feed system-architecture.json riskFlags.",
  "type": "object",
  "required": ["meta", "personas", "verdict"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["mode", "slug"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["solo", "magi"] },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "agent": { "type": "string" },
        "ranAt": { "type": "string" }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "verdict", "confidence", "findings"],
        "additionalProperties": false,
        "properties": {
          "name": { "enum": ["Grunt", "Melchior", "Balthasar", "Casper"] },
          "lens": { "type": "string" },
          "verdict": { "enum": ["approve", "revise", "reject"] },
          "confidence": { "enum": ["high", "med", "low"] },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["severity", "claim"],
              "additionalProperties": false,
              "properties": {
                "severity": { "enum": ["P0", "P1", "P2"] },
                "claim": { "type": "string" },
                "target": { "type": "string" },
                "evidence": { "type": "string" },
                "fix": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "verdict": { "enum": ["approve", "revise", "reject"] },
    "confidence": { "enum": ["high", "med", "low"] },
    "dissent": { "type": "string" },
    "summary": { "type": "string" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "astra-os/call-stack-types.schema.json",
  "title": "Astra Gate 3 — Program Design Contracts",
  "description": "Exact file locations, signatures, call stacks, and test assertions. No implementation bodies. This artifact is the write boundary source for Gate 4 agent roles.",
  "type": "object",
  "required": ["meta", "files", "callStacks", "tests"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "language"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "language": { "type": "string", "description": "typescript | python | go | ..." },
        "generatedBy": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "purpose", "exports"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "status": { "enum": ["new", "modified"] },
          "exports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "name", "signature"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["function", "class", "interface", "type", "const", "enum", "component", "hook"] },
                "name": { "type": "string" },
                "signature": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "extends": { "type": "string" },
                "throws": { "type": "array", "items": { "type": "string" } },
                "pure": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "callStacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "entry", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "entry": { "type": "string", "description": "fully-qualified entry symbol" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "layer", "target", "assertions"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "layer": { "enum": ["static", "unit", "integration", "e2e"] },
          "target": { "type": "string" },
          "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "typeBoundaries": {
      "type": "array",
      "description": "Where data crosses a trust or process boundary and must be validated.",
      "items": {
        "type": "object",
        "required": ["boundary", "shape"],
        "additionalProperties": false,
        "properties": {
          "boundary": { "type": "string" },
          "shape": { "type": "string" },
          "validator": { "type": "string" }
        }
      }
    }
  }
}
